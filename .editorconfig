# Editor and analyser settings for the whole repository.
# `EnforceCodeStyleInBuild` in Directory.Build.props turns the IDExxxx rules
# below into build diagnostics, so CI catches style drift the same way a
# reviewer would.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,slnx,http}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# --- Namespaces -------------------------------------------------------------
# The codebase already uses file-scoped namespaces almost everywhere; this
# makes the few block-scoped holdouts show up as warnings instead of drifting.
csharp_style_namespace_declarations = file_scoped:warning

# --- Usings -----------------------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
# Unused usings are a warning, not silent noise: they hide real dependencies.
dotnet_diagnostic.IDE0005.severity = warning

# --- Language style ---------------------------------------------------------
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion

# --- Naming -----------------------------------------------------------------
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# --- Correctness ------------------------------------------------------------
# An un-awaited Task in a controller silently swallows exceptions and returns
# before the work is done, which is exactly the class of bug the API cannot
# afford in its auth and progress-writing paths.
dotnet_diagnostic.CS4014.severity = error

[src/LanGigaCards.Api/Migrations/*.cs]
# Generated by `dotnet ef migrations add`; formatting is not ours to enforce.
generated_code = true
dotnet_analyzer_diagnostic.severity = none

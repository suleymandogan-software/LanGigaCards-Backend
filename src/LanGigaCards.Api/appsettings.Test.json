{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=<test-sql-host>;Database=LanGigaCardsDb;User ID=<sql-user>;Password=<set-via-env-var>;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "LanGigaCardsAPI",
    "Audience": "LanGigaCardsApp"
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    },
    "Apple": {
      "ClientId": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<test-frontend-host>"
    ]
  },
  "Smtp": {
    "Host": "<smtp-host>",
    "Port": 587,
    "User": "<smtp-user>",
    "FromAddress": "servis@gigabyteltd.com",
    "FromName": "LanGigaCards",
    "EnableSsl": true
  }
}
